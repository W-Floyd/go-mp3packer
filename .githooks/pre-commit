#!/usr/bin/env sh
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Pre-commit: gofmt"
if [ -n "$(gofmt -l .)" ]; then
	echo "FAIL: gofmt found unformatted Go files"
	gofmt -l .
	exit 1
fi

# ./... stops at the module boundary even inside a workspace, so the tools module
# has to be named separately or nothing in it is ever checked.
echo "Pre-commit: go vet"
go vet ./... ./tools/...

echo "Pre-commit: go test"
go test ./... ./tools/...

echo "Pre-commit: OK"

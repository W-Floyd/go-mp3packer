# The built binary, from `go build ./cmd/mp3packer` at the root or from inside the
# command's own directory. Both are anchored: a bare "mp3packer" also matches the
# cmd/mp3packer *directory*, and would silently ignore any new source file added
# there — main.go only survives that by being tracked already.
/mp3packer
/cmd/mp3packer/mp3packer

# Test binaries and profile output.
*.test
*.out

/dist/

# Benchmark material kept locally rather than committed, which is what
# MP3PACKER_BENCH_FILE is for. Anchored, so testdata is unaffected.
/*.mp3

# benchsteps takes a lock while it measures, so that two sweeps cannot interleave
# their writes or contend for the machine.
*.lock

# Test binaries benchsteps built from each commit, kept so that a re-run does not
# rebuild the whole history. Their names carry the harness and toolchain they were
# built with, so a stale one is never reused.
/bench/.build/
